{
  "name": "cms/ai-builder-plugin",
  "description": "Remote-control REST plugin driven by the Express CMS",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "AiBuilder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AiBuilder\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "test": "phpunit",
    "package": "bash scripts/package.sh"
  }
}
